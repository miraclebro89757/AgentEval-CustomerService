# Agent 运行时：ollama（默认，本地 Qwen 7B）| openai | heuristic
AGENT_LLM=ollama

# DeepEval 裁判：heuristic（默认，规则门禁，快）| ollama | openai | auto
# 业务节点已经走 Qwen；裁判再用本地 7B 做 GEval 会慢且不稳，需要时再打开。
JUDGE_LLM=heuristic

# 本地 Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
# AGENT_TEMPERATURE=0

# OpenAI（可选）
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# reliability 用例连跑次数（仅 AGENT_LLM != heuristic 时生效）
EVAL_PASS_K=3

# 可选：覆盖默认 prompt 包（prompts/packs/<name>/{agents,judges}）
# PROMPT_PACK=

# 可选：把 Trace 传到 Confident AI。没有 Key 时 main.py 会关闭上报。
# CONFIDENT_API_KEY=
# CONFIDENT_TRACING_ENABLED=NO
