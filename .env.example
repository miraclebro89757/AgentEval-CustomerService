# Agent 运行时：heuristic（默认，无需模型）| openai | ollama
AGENT_LLM=heuristic

# DeepEval 裁判模型：auto | openai | ollama | heuristic
# auto = 有 OPENAI_API_KEY 用 OpenAI，否则尝试 Ollama，再否则走确定性指标
JUDGE_LLM=auto

# OpenAI（Agent 或 Judge 任一侧需要时填写）
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Ollama 本地模型（可选，方便零云端跑通 LLM 模式）
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# 可选：覆盖默认 prompt 包（prompts/packs/<name>/{agents,judges}）
# PROMPT_PACK=

# 可选：把 Trace 传到 Confident AI。没有 Key 时 main.py 会关闭上报。
# CONFIDENT_API_KEY=
# CONFIDENT_TRACING_ENABLED=NO
